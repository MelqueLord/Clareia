# Referência para um ambiente SEPARADO de homologação Cloudflare Worker + D1.
# Configure no painel da hospedagem. Não publique segredos neste arquivo.
# O binding DB deve apontar para o banco exclusivo da homologação.
BETTER_AUTH_URL=https://homologacao.seu-dominio.com.br
BETTER_AUTH_SECRET=

# Abrir somente na janela de cadastro acompanhada; fechar após os convites.
# A lista limita novos cadastros; não concede privilégios nem revoga contas existentes.
AUTH_SIGNUP_ENABLED=false
AUTH_SIGNUP_POLICY=allowlist
# E-mails exatos separados por vírgula, ponto e vírgula ou quebra de linha.
# Lista vazia ou inválida recusa novos cadastros. Preencher somente no painel seguro.
AUTH_SIGNUP_ALLOWED_EMAILS=
PILOT_MAX_ACCOUNTS=10
TRIAL_DURATION_DAYS=30

# Vincular somente após comprovar a titularidade da conta (docs/ADMIN.md).
TRIAL_ADMIN_EMAIL=
TRIAL_ADMIN_USER_ID=

# Preencher com domínio remetente verificado e testar a entrega.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=

# Piloto gratuito: manter as chaves Asaas ausentes; não haverá chamadas de cobrança.
# Sem chaves, /api/billing/request apenas registra interesse no modo manual.
# Nunca copiar credenciais de produção para a homologação.
ASAAS_ENVIRONMENT=sandbox

# Opcionais; configurar apenas se notificações fizerem parte do piloto.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_JWK=
